<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PackageId>SAIB.Cbor</PackageId>
    <PackageReleaseNotes>cf. https://github.com/SAIB-Inc/Dahomey.Cbor/releases/tag/$(Version)</PackageReleaseNotes>
    <Authors>Clark Alesna;Michaël Catanzariti</Authors>
    <Company>SAIB Inc</Company>
    <Description>High-performance CBOR serialization framework for .Net (fork of Dahomey.Cbor by Dahomey Technologies)</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SAIB-Inc/Dahomey.Cbor</PackageProjectUrl>
    <PackageTags>cbor;serialization;json</PackageTags>
    <RepositoryUrl>https://github.com/SAIB-Inc/Dahomey.Cbor.git</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
    <Copyright>Copyright © Dahomey Technologies 2020, SAIB Inc 2025</Copyright>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Collections.Immutable" Version="10.0.1" />
    <PackageReference Include="Nullable" Version="1.3.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
      <PackageReference Include="System.IO.Pipelines" Version="10.0.1" />
  </ItemGroup>

</Project>
